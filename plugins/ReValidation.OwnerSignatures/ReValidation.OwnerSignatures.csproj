<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Use_DalamudPackager>false</Use_DalamudPackager>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="..\local\LocalClientStructs.props" Condition="Exists('..\local\LocalClientStructs.props')" />

  <ItemGroup>
    <ProjectReference Include="..\ReValidation.Common\ReValidation.Common.csproj" />
    <Reference Include="FFXIVClientStructs" HintPath="$(DalamudLibPath)FFXIVClientStructs.dll" Private="false" />
    <Reference Include="Lumina" HintPath="$(DalamudLibPath)Lumina.dll" Private="false" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudLibPath)Lumina.Excel.dll" Private="false" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)Dalamud.Bindings.ImGui.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Runtime\Proof\OwnerHookProofRecord.cs" />
    <Compile Remove="Runtime\Proof\OwnerHookProofStage.cs" />
    <Compile Remove="Runtime\Proof\OwnerHookProofStatus.cs" />
    <Compile Remove="Runtime\Proof\OwnerHookScenarioEvidence.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ClientStructsProjectPath</_Parameter1>
      <_Parameter2>$(ClientStructsProjectPath)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReValidation.Tests" />
  </ItemGroup>

</Project>
