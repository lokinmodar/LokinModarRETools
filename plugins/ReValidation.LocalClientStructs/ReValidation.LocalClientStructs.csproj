<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Use_DalamudPackager>false</Use_DalamudPackager>
    <RequireLocalClientStructs Condition="'$(RequireLocalClientStructs)' == ''">false</RequireLocalClientStructs>
  </PropertyGroup>

  <Import Project="..\local\LocalClientStructs.props" Condition="Exists('..\local\LocalClientStructs.props')" />

  <ItemGroup>
    <ProjectReference Include="..\ReValidation.Common\ReValidation.Common.csproj" />
    <ProjectReference Include="$(ClientStructsProjectPath)" Condition="'$(ClientStructsProjectPath)' != '' and Exists('$(ClientStructsProjectPath)')" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)Dalamud.Bindings.ImGui.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateLocalClientStructs" BeforeTargets="Build">
    <Error Condition="'$(RequireLocalClientStructs)' == 'true' and !Exists('$(MSBuildThisFileDirectory)..\local\LocalClientStructs.props')"
           Text="Local ClientStructs is required, but plugins/local/LocalClientStructs.props is missing." />
    <Error Condition="'$(RequireLocalClientStructs)' == 'true' and '$(ClientStructsProjectPath)' == ''"
           Text="Local ClientStructs is required, but ClientStructsProjectPath is empty." />
    <Error Condition="'$(RequireLocalClientStructs)' == 'true' and '$(ClientStructsProjectPath)' != '' and !Exists('$(ClientStructsProjectPath)')"
           Text="Local ClientStructs is required, but ClientStructsProjectPath does not exist: $(ClientStructsProjectPath)." />
  </Target>

</Project>
